{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L2UnkBot",
  "version": "0.1.0",
  "identifier": "com.unkbot.desktop",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "L2UnkBot",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: gameicon: http://gameicon.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "Bot nativo para Lineage II C4",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
